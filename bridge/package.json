{
  "name": "qq-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge between SnowLuma (OneBot v11 / QQ) and DeepSeek Harness Web API: QQ messages become DSH agent prompts, agent replies go back to QQ.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/bridge.js",
    "self-test": "node src/self-test.js",
    "test-md": "node scripts/test-md-to-plain.mjs",
    "test-wait": "node scripts/test-v2-wait.mjs",
    "test-vision": "node scripts/test-vision-media.mjs",
    "test-forward": "node scripts/test-forward.mjs",
    "test-error-routing": "node scripts/test-error-routing.mjs",
    "test-routing": "node scripts/test-preset-routing.mjs",
    "test-session-switch": "node --test scripts/test-session-switch.mjs",
    "test-turn-auth": "node scripts/test-turn-auth.mjs",
    "test-turn-auth-guard": "node scripts/test-turn-auth-guard.mjs",
    "test-slang": "node scripts/test-slang-learn.mjs",
    "test-stickers": "node scripts/test-stickers.mjs",
    "postinstall": "node scripts/patch-snowluma-sdk.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@snowluma/mcp": "^1.14.10",
    "@snowluma/sdk": "^1.14.0",
    "marked": "^18.1.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  }
}
